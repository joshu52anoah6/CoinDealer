# Backend API origin. Keep empty when Nginx reverse-proxies the API on the same domain.
VITE_API_BASE_URL=

# Optional Vite build output directory. Keep `dist` locally; the server deploys its contents to:
# /home/ec2-user/cdn/third-pay
VITE_BUILD_OUT_DIR=dist

# Coin-merchant portal contracts from Apifox. Leave the defaults when the
# backend uses the authenticated App paths; override them for dedicated
# merchant endpoints without changing the frontend.
VITE_MERCHANT_LOGIN_PATH=/merchant/login
VITE_MERCHANT_CONFIG_PATH=/rechargeCfg/rechargeCfgListByUserId
VITE_MERCHANT_RECHARGE_PATH=/rechargeOrder/createRechargeOrder
VITE_MERCHANT_WS_PATH=/ws/merchant
# Set VITE_MERCHANT_WS_URL when Apifox gives an absolute ws:// or wss:// URL.
VITE_MERCHANT_WS_URL=
