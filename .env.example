# Backend API origin. Keep empty when Nginx reverse-proxies the API on the same domain.
VITE_API_BASE_URL=

# Authenticated merchant push endpoint. The current merchant token is supplied
# as the Authorization query parameter used by the Sora WebSocket transport.
VITE_WEBSOCKET_URL=

# Optional Vite build output directory. Keep `dist` locally; the server deploys its contents to:
# /home/ec2-user/cdn/coin-merchant
VITE_BUILD_OUT_DIR=dist

# Latest complete merchant deployment loaded after the API reports that the
# client's wire-encryption key is outdated.
VITE_MERCHANT_SITE_URL=

# Coin-merchant portal contracts from Apifox. The defaults are the dedicated
# coin-merchant endpoints; override them only when a gateway rewrites paths.
VITE_MERCHANT_LOGIN_PATH=/auth/coinMerchantLogin
VITE_MERCHANT_CONFIG_PATH=/coinMerchantRechargeCfg/coinMerchantRechargeCfgListForApp
VITE_MERCHANT_PAYMENT_REGION_PATH=/coinMerchantRechargeCfg/paymentRegionList
VITE_MERCHANT_RECHARGE_PATH=/rechargeOrder/createCoinMerchantChannelRechargeOrder
VITE_MERCHANT_ORDER_STATUS_PATH=/rechargeOrder/checkRechargeOrderSuccess
VITE_MERCHANT_ORDER_LIST_PATH=/rechargeOrder/myRechargeOrderList
VITE_MERCHANT_TRANSFER_PATH=/gold/transferGold
VITE_MERCHANT_BALANCE_PATH=/userInfo/get
VITE_MERCHANT_TRANSFER_RECORD_PATH=/gold/getCoinMerchantTransferRecordList
VITE_MERCHANT_PROFILE_GET_PATH=/rechargeOrder/getChannelPayUserProfile
VITE_MERCHANT_PROFILE_SAVE_PATH=/rechargeOrder/saveChannelPayUserProfile
# Merchant request/response AES-256-GCM wire protection. Current test/prod
# builds keep this disabled and send X-Coin-Merchant-Client: 0.
VITE_MERCHANT_API_ENCRYPTION=false
VITE_MERCHANT_API_KEY=
